<Window x:Class="ChatAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina"
        Width="1320"
        Height="850"
        MinWidth="1060"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#080C18"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        Icon="Assets/lumina-mark.png"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#080C18"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#10182A"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#162239"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#1D2A45"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#22D3EE"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9EACC5"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#283958"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A855F7" Offset="0"/>
            <GradientStop Color="#4F46E5" Offset="0.48"/>
            <GradientStop Color="#0891B2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroPanelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#241340" Offset="0"/>
            <GradientStop Color="#111C38" Offset="0.52"/>
            <GradientStop Color="#0A2B38" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource HeroGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.34"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#2B3C5D"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SoftBrush}"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Padding" Value="7"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource SoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="Padding" Value="7"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabShell" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="0,0,5,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabShell" Property="Background" Value="#2A2453"/>
                                <Setter Property="Foreground" Value="#E9D5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabShell" Property="Background" Value="#1D2A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1223" BorderBrush="#1D2942" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="17" Background="#131C31">
                        <Image Source="Assets/lumina-mark.png" Width="50" Height="50" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LUMINA" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="See what changed before you had words for it." Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#113228" BorderBrush="#1D6A52" BorderThickness="1" CornerRadius="14" Padding="12,7" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="Local-first • private by default" Foreground="#A7F3D0" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="OpenExplorerButton" Click="OpenExplorer_Click" Style="{StaticResource SecondaryButton}" Content="Open archive explorer"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#35245C" CornerRadius="10" Padding="9,4" Margin="0,0,9,0"><TextBlock Text="STEP 1" Foreground="#D8B4FE" FontSize="11" FontWeight="Bold"/></Border>
                            <TextBlock Text="Bring in your history" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Drop ChatGPT exports anywhere in this window, choose them manually, or let Lumina find likely exports in Downloads."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,13" LineHeight="20"/>
                        <Button x:Name="AddExportsButton" Click="AddExports_Click" Style="{StaticResource PrimaryButton}" Height="46" Content="＋  Choose export files"/>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Click="FindExports_Click" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Content="Find exports"/>
                            <Button Click="LoadDemo_Click" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Content="Try a demo"/>
                        </UniformGrid>
                        <TextBlock x:Name="FileSummaryText" Text="No history loaded yet" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,10,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrushColor}" Margin="0,16,0,13"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="LOADED SOURCES" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold"/>
                        <ListBox x:Name="FilesList" Grid.Row="1" Margin="0,7,0,8" MinHeight="65" MaxHeight="145" Background="Transparent" BorderThickness="0" SelectionChanged="FilesList_SelectionChanged"/>
                        <Border x:Name="FilePreviewBorder" Grid.Row="2" Padding="12" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="12">
                            <StackPanel x:Name="FilePreviewPanel"><TextBlock Text="Select a source to preview it" Foreground="{StaticResource TextSecondary}" FontSize="12"/></StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="#123849" CornerRadius="10" Padding="9,4" Margin="0,0,9,0"><TextBlock Text="STEP 2" Foreground="#A5F3FC" FontSize="11" FontWeight="Bold"/></Border>
                            <TextBlock Text="Reveal the pattern" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="AnalyzeButton" Click="Analyze_Click" Style="{StaticResource PrimaryButton}" Height="52" IsEnabled="False" Content="Analyze my timeline  →"/>
                        <ProgressBar x:Name="AnalysisProgress" Height="4" Margin="3,10,3,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource CyanBrush}" Background="{StaticResource SoftBrush}"/>
                    </StackPanel>

                    <Expander Grid.Row="4" Header="Advanced AI settings" Foreground="{StaticResource TextSecondary}" Margin="0,15,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Reasoning provider" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <ComboBox x:Name="ProviderCombo" SelectedIndex="0" Margin="0,5,0,0">
                                <ComboBoxItem>Local analysis only</ComboBoxItem><ComboBoxItem>Azure OpenAI (cloud)</ComboBoxItem><ComboBoxItem>OpenAI (legacy cloud)</ComboBoxItem><ComboBoxItem>Ollama (local)</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="API key override" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,9,0,0"/>
                            <PasswordBox x:Name="ApiKeyBox" Margin="0,5,0,0"/>
                            <Button x:Name="QuickAskButton" Click="QuickAsk_Click" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Content="Test selected source" IsEnabled="False"/>
                            <ToggleButton x:Name="SpiritBoxToggle" Margin="0,10,0,0" Padding="9" Content="Experimental symbolic output" Checked="SpiritBoxToggle_Checked" Unchecked="SpiritBoxToggle_Unchecked"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Your evolving story" FontSize="31" FontWeight="SemiBold"/>
                        <TextBlock Text="Specific changes. Independent signals. The receipts behind every claim." Foreground="{StaticResource TextSecondary}" FontSize="14" Margin="0,7,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="14" Padding="16,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="LIVE STATUS" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="StatusText" Text="Waiting for your history" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="290"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,18">
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="ConversationCountText" Text="—" FontSize="23" FontWeight="Bold"/><TextBlock Text="conversations" Foreground="{StaticResource TextSecondary}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="MessageCountText" Text="—" FontSize="23" FontWeight="Bold"/><TextBlock Text="messages" Foreground="{StaticResource TextSecondary}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="EventCountText" Text="—" FontSize="23" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="timeline events" Foreground="{StaticResource TextSecondary}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource CardBorder}" Padding="14"><StackPanel><TextBlock x:Name="FindingCountText" Text="—" FontSize="23" FontWeight="Bold" Foreground="#D8B4FE"/><TextBlock Text="strong findings" Foreground="{StaticResource TextSecondary}" FontSize="11"/></StackPanel></Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabItem Header="✦  Insights">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,10,8,6"><StackPanel x:Name="FindingsPanel"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="⌁  Signal timeline">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,10,8,6"><StackPanel x:Name="TimelinePanel"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="◈  How it works">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                                <StackPanel>
                                    <TextBlock Text="Lumina does not summarize your chats." FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Text="It reconstructs evidence over time, separates your words from assistant context, compares earlier and later states, and requires independent signals before surfacing a claim." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="14" LineHeight="22" Margin="0,10,0,20"/>
                                    <UniformGrid Columns="3">
                                        <Border Style="{StaticResource CardBorder}" Padding="17" Margin="0,0,8,0"><StackPanel><TextBlock Text="01" Foreground="#D8B4FE" FontSize="18" FontWeight="Bold"/><TextBlock Text="Reconstruct" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Actions, decisions, outcomes, preferences, and claims become dated evidence events." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                                        <Border Style="{StaticResource CardBorder}" Padding="17" Margin="4,0"><StackPanel><TextBlock Text="02" Foreground="#A5F3FC" FontSize="18" FontWeight="Bold"/><TextBlock Text="Compare" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Early and later evidence is compared across independent conversations and time windows." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                                        <Border Style="{StaticResource CardBorder}" Padding="17" Margin="8,0,0,0"><StackPanel><TextBlock Text="03" Foreground="#FDBA74" FontSize="18" FontWeight="Bold"/><TextBlock Text="Challenge" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Every finding keeps its receipts so you can reject weak or obvious interpretations." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
