<Window x:Class="ChatAnalyzer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina"
        Width="1050"
        Height="760"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F1720"
        Foreground="#FFF0F3F7">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1720"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#12171C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EEF6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6B1BD"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#263036"/>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="LUMINA" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Longitudinal intelligence from your ChatGPT history" Margin="0,6,0,12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>

                <Button x:Name="AddExportsButton" Click="AddExports_Click" Style="{StaticResource PrimaryButton}" Height="42" Content="+ Add ChatGPT Exports"/>

                <Button x:Name="OpenExplorerButton" Click="OpenExplorer_Click" Margin="0,8,0,0" Height="36" Content="Open Archive Explorer" />

                <TextBlock Text="LLM Provider" Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <ComboBox x:Name="ProviderCombo" SelectedIndex="0" Margin="0,6,0,0">
                    <ComboBoxItem>Local analysis only</ComboBoxItem>
                    <ComboBoxItem>Azure OpenAI (cloud)</ComboBoxItem>
                    <ComboBoxItem>OpenAI (legacy cloud)</ComboBoxItem>
                    <ComboBoxItem>Ollama (local)</ComboBoxItem>
                </ComboBox>

                <TextBlock Text="Azure API Key (optional if environment is configured)" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                <TextBox x:Name="ApiKeyBox" Margin="0,6,0,0" Height="26" />

                <TextBlock x:Name="FileSummaryText" Margin="0,14,0,0" Foreground="{StaticResource TextSecondary}" FontSize="13">No exports loaded.</TextBlock>

                <ListBox x:Name="FilesList" Margin="0,8,0,0" MaxHeight="220" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" SelectionChanged="FilesList_SelectionChanged"/>

                <Button x:Name="QuickAskButton" Click="QuickAsk_Click" Margin="0,10,0,0" Height="34" Content="Quick Ask LLM (selected file)" IsEnabled="False" />

                <Border x:Name="FilePreviewBorder" Margin="0,10,0,0" Padding="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8">
                    <StackPanel x:Name="FilePreviewPanel">
                        <TextBlock Text="No file selected" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <Button x:Name="AnalyzeButton" Click="Analyze_Click" Margin="0,16,0,0" Height="44" Style="{StaticResource PrimaryButton}" IsEnabled="False">ANALYZE</Button>

                <ToggleButton x:Name="SpiritBoxToggle" Margin="0,10,0,0" Height="36" Content="Spirit Box Mode" Checked="SpiritBoxToggle_Checked" Unchecked="SpiritBoxToggle_Unchecked" />

                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource TextSecondary}" FontSize="12">Tip: load multiple exports to enable merging and longitudinal analysis.</TextBlock>
            </StackPanel>
        </Border>

        <!-- Spacer column -->
        <Grid Grid.Column="1"/>

        <!-- Main content -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Hidden developments" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap">Load one or more ChatGPT export files to begin.</TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FindingsPanel"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
